[Unit]
Description=LLMAutoTel authenticated voice relay
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=turnserver
Group=turnserver
ExecStart=/usr/bin/turnserver -c /etc/llmautotel/turnserver.conf --pidfile=
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=llmautotel-turn
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
