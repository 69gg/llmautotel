[Unit]
Description=LLMAutoTel voice consultation workbench
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=llmautotel
Group=llmautotel
WorkingDirectory=/opt/llmautotel/current
EnvironmentFile=/etc/llmautotel/service.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_CACHE_HOME=/var/cache/llmautotel
ExecStart=/opt/llmautotel/current/.venv/bin/llmautotel
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=llmautotel
StateDirectoryMode=0700
CacheDirectory=llmautotel
CacheDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
